import Workspace.parser;
import Workspace.sema;
import Workspace.ir;
import Workspace.link;
import Workspace.emit_c;

##
 * zzc — frontend Z# dla GCC. Sterownik w stylu gcc: tłumaczy .zs/.zsharp na C (Z# IR -> emit_c) i oddaje kompilację
 * do GCC wraz z natywnym runtime (runtime/native/zs_rt.c). Nierozpoznane opcje trafiają bez zmian do gcc,
 * więc działają -O2 -g -flto -march=native -fsanitize=address -static -Wl,... itd.
 * Uwaga: to frontend „przez C" (jak wczesne cfront/f2c), a nie wtyczka cc1 — patrz README.
##

func version(): string { return "zzc 0.1.0 (frontend GCC: Z# -> IR -> C -> gcc; pełny język, importy, cache runtime)"; }

func usage(): void {
    echo "zzc — frontend Z# dla GCC";
    echo "użycie: zzc [opcje gcc] <plik.zs> [-o wyjście]";
    echo "  -c            tylko obiekt (.o) — bez runtime; zlinkuj z `zzc --runtime-obj`";
    echo "  -S            asembler (.s) wygenerowany przez gcc";
    echo "  --emit-c      tylko kod C (.c)";
    echo "  --gcc <gcc>   kompilator (domyślnie $ZZC_GCC, potem gcc, cc); np. aarch64-linux-gnu-gcc";
    echo "  run <plik> [-- args]   zbuduj i uruchom;  --no-cache — nie używaj cache runtime";
    echo "  --print-cmd   pokaż wywołanie gcc; --dry-run — nie uruchamiaj";
    echo "  --runtime     wypisz ścieżkę runtime/native/zs_rt.c; --runtime-obj <wyjście.o> skompiluj runtime";
    echo "  --strict      ostrzeżenia sema jako błędy; --version | --help";
    echo "inne opcje (-O3, -g, -flto, -I.., -l.., -Wl,...) są przekazywane do gcc";
    echo "zmienne: ZS_HOME (katalog Z-Sharp), ZZC_GCC";
}

func is_src(string $a): bool { return ends_with($a, ".zs") || ends_with($a, ".zsharp"); }

func zs_root(string $scriptDir) {
    $env = System.env("ZS_HOME");
    if ($env !== null && $env !== "") { return $env; }
    $d = $scriptDir;
    if (!starts_with($d, "/")) { $d = (System.env("PWD") ?? ".") . "/" . $d; }
    foreach ([$d . "/../share/z-sharp", $d . "/share/z-sharp"] as $c) {
        if (File.exists($c . "/runtime/native/zs_rt.c")) { return $c; }
    }
    $f = System.resolveImport(["Workspace", "cli"], $scriptDir);
    if ($f === null) { return null; }
    return System.dirname(System.dirname($f));
}

func find_gcc($explicit) {
    $cands = [];
    if ($explicit !== null) { $cands[] = $explicit; }
    $e = System.env("ZZC_GCC");
    if ($e !== null && $e !== "") { $cands[] = $e; }
    foreach (["gcc", "cc"] as $c) { $cands[] = $c; }
    foreach ($cands as $c) {
        try { $r = Process.run($c, ["--version"]); if ($r["status"] === 0) { return $c; } }
        catch (Exception $x) { }
    }
    return null;
}

func stem(string $p): string {
    $b = $p;
    for ($i = 0; $i < strlen($p); $i++) { if (substr($p, $i, 1) === "/") { $b = substr($p, $i + 1); } }
    $dot = -1;
    for ($i = 0; $i < strlen($b); $i++) { if (substr($b, $i, 1) === ".") { $dot = $i; } }
    return $dot > 0 ? substr($b, 0, $dot) : $b;
}

func array_concat($a, $b) {
    $o = [];
    foreach ($a as $x) { $o[] = $x; }
    foreach ($b as $x) { $o[] = $x; }
    return $o;
}

func quote(string $s): string {
    if ($s === "" || contains($s, " ") || contains($s, "\"")) { return "'" . $s . "'"; }
    return $s;
}

func translate(string $file, bool $strict) {
    if (!File.exists($file)) { eecho("zzc: nie znaleziono pliku " . $file); return null; }
    try { $ast = parser.parse(File.read($file)); }
    catch (Exception $e) { eecho($file . ":" . $e->getMessage()); return null; }
    $r = sema.analyze($ast);
    foreach ($r["warnings"] as $w) { eecho($file . ":" . $w[0] . ": ostrzeżenie: " . $w[1]); }
    if ($strict && count($r["warnings"]) > 0) { return null; }
    $lk = link.link($ast, $file);
    if (count($lk["errors"]) > 0) {
        foreach ($lk["errors"] as $e) { eecho($e[3] . ":" . $e[0] . ": błąd [" . $e[1] . "]: " . $e[2]); }
        eecho("zzc: " . count($lk["errors"]) . " błędów linkowania modułów");
        return null;
    }
    $res = ir.lower($lk["ast"]);
    if (count($res["errors"]) > 0) {
        foreach ($res["errors"] as $e) { eecho($file . ":" . $e[0] . ": błąd [" . $e[1] . "]: " . $e[2]); }
        eecho("zzc: " . count($res["errors"]) . " błędów — konstrukcje spoza zakresu backendu natywnego");
        return null;
    }
    try { return emit_c.generate($res); }
    catch (Exception $e) { eecho("zzc: błąd wewnętrzny: " . $e->getMessage()); return null; }
}

func hex32($h): string {
    $d = "0123456789abcdef";
    $o = "";
    for ($i = 0; $i < 8; $i++) { $o = substr($d, $h & 15, 1) . $o; $h = $h >> 4; }
    return $o;
}

func fnv(string $s): string {
    $h = 2166136261;
    $n = strlen($s);
    for ($i = 0; $i < $n; $i++) { $h = (($h ^ ord(substr($s, $i, 1))) * 16777619) & 4294967295; }
    return hex32($h);
}

func mkdirs($path) {
    if (Directory.exists($path)) { return; }
    $cur = starts_with($path, "/") ? "" : ".";
    foreach (split($path, "/") as $p) {
        if ($p === "") { continue; }
        $cur = $cur . "/" . $p;
        if (!Directory.exists($cur)) { Directory.create($cur); }
    }
}

func cache_dir(): string {
    $e = System.env("ZZC_CACHE");
    if ($e !== null && $e !== "") { return $e; }
    $x = System.env("XDG_CACHE_HOME");
    if ($x !== null && $x !== "") { return $x . "/zzc"; }
    return (System.env("HOME") ?? "/tmp") . "/.cache/zzc";
}

# flagi wpływające na kod obiektowy runtime (kompilacja); reszta (-l, -L, -Wl,...) idzie tylko do linkowania
func is_cflag(string $p): bool {
    return starts_with($p, "-O") || starts_with($p, "-f") || starts_with($p, "-m") || starts_with($p, "-g") || starts_with($p, "-D") || starts_with($p, "-pg") || starts_with($p, "--target") || starts_with($p, "-std");
}

##
 * Obiekt runtime: kompilowany raz na (gcc, flagi, wersja źródeł) i trzymany w cache.
##
func runtime_object($gcc, $root, $cflags) {
    $src = $root . "/runtime/native/zs_rt.c";
    $hdr = $root . "/runtime/include/zs_native.h";
    $ss = File.stat($src);
    $hs = File.stat($hdr);
    $v = Process.run($gcc, ["-dumpfullversion", "-dumpmachine"]);
    $key = fnv($gcc . "|" . join($cflags, " ") . "|" . trim($v["stdout"]) . "|" . $ss["size"] . ":" . $ss["mtime"] . ":" . $hs["size"] . ":" . $hs["mtime"]);
    $dir = cache_dir();
    $obj = $dir . "/rt-" . $key . ".o";
    if (File.exists($obj)) { return $obj; }
    try { mkdirs($dir); } catch (Exception $e) { return null; }
    $tmp = $obj . "." . System.pid() . ".tmp";
    $args = ["-c", "-std=gnu11", "-w", "-I", $root . "/runtime/include"];
    $hasOpt = false;
    foreach ($cflags as $f) { if (starts_with($f, "-O")) { $hasOpt = true; } $args[] = $f; }
    if (!$hasOpt) { $args[] = "-O2"; }
    $args[] = $src;
    $args[] = "-o";
    $args[] = $tmp;
    $r = Process.run($gcc, $args);
    if ($r["status"] !== 0) { eecho($r["stderr"]); return null; }
    File.rename($tmp, $obj);
    return $obj;
}

func main(): int {
    $argv = System.args();
    $scriptDir = System.dirname($argv[0]);
    $mode = "exe";
    $out = null;
    $gccExe = null;
    $printCmd = false;
    $dry = false;
    $strict = false;
    $emitC = false;
    $srcs = [];
    $pass = [];
    $run = false;
    $runArgs = [];
    $cacheOff = [];
    $i = 1;
    while ($i < count($argv)) {
        $a = $argv[$i];
        if ($a === "--version") { echo version(); return 0; }
        else if ($a === "--help" || $a === "-h") { usage(); return 0; }
        else if ($a === "-c") { $mode = "obj"; }
        else if ($a === "-S") { $mode = "asm"; }
        else if ($a === "--emit-c") { $emitC = true; }
        else if ($a === "--print-cmd") { $printCmd = true; }
        else if ($a === "--dry-run") { $dry = true; $printCmd = true; }
        else if ($a === "--strict") { $strict = true; }
        else if ($a === "--gcc" && $i + 1 < count($argv)) { $i++; $gccExe = $argv[$i]; }
        else if ($a === "-o" && $i + 1 < count($argv)) { $i++; $out = $argv[$i]; }
        else if ($a === "-x" && $i + 1 < count($argv)) { $i++; }
        else if ($a === "build") { }
        else if ($a === "run") { $run = true; }
        else if ($a === "--no-cache") { $cacheOff["x"] = true; }
        else if ($a === "--") { for ($j = $i + 1; $j < count($argv); $j++) { $runArgs[] = $argv[$j]; } break; }
        else if ($a === "--runtime") {
            $root = zs_root($scriptDir);
            if ($root === null) { eecho("zzc: ustaw ZS_HOME"); return 1; }
            echo $root . "/runtime/native/zs_rt.c";
            return 0;
        }
        else if ($a === "--runtime-obj" && $i + 1 < count($argv)) {
            $i++;
            $root = zs_root($scriptDir);
            $g = find_gcc($gccExe);
            if ($root === null || $g === null) { eecho("zzc: brak ZS_HOME lub gcc"); return 1; }
            $r = Process.run($g, ["-c", "-O2", "-std=gnu11", "-w", "-I", $root . "/runtime/include", $root . "/runtime/native/zs_rt.c", "-o", $argv[$i]]);
            if ($r["status"] !== 0) { eecho($r["stderr"]); return 1; }
            return 0;
        }
        else if (is_src($a)) { $srcs[] = $a; }
        else { $pass[] = $a; }
        $i++;
    }
    if (count($srcs) === 0) { usage(); return 2; }
    if (count($srcs) > 1) { eecho("zzc: jeden plik wejściowy na wywołanie (pozostałe moduły przez `import`)"); return 2; }
    $src = $srcs[0];
    $c = translate($src, $strict);
    if ($c === null) { return 1; }
    $base = stem($src);
    if ($emitC) {
        $cp = $out ?? ($base . ".c");
        File.write($cp, $c);
        echo "zzc: " . $cp;
        return 0;
    }
    $root = zs_root($scriptDir);
    if ($root === null || !File.exists($root . "/runtime/native/zs_rt.c")) { eecho("zzc: nie znaleziono Z-Sharp/runtime/native/zs_rt.c — ustaw ZS_HOME"); return 1; }
    $gcc = find_gcc($gccExe);
    if ($gcc === null) { eecho("zzc: nie znaleziono gcc (zainstaluj lub użyj --gcc / ZZC_GCC)"); return 1; }
    $tmp = ($out ?? $base) . ".zzc.c";
    File.write($tmp, $c);
    $cflags = [];
    $hasOpt = false;
    foreach ($pass as $p) { if (starts_with($p, "-O")) { $hasOpt = true; } if (is_cflag($p)) { $cflags[] = $p; } }
    $args = ["-std=gnu11", "-w", "-I", $root . "/runtime/include"];
    if (!$hasOpt) { $args[] = "-O2"; }
    foreach ($pass as $p) { $args[] = $p; }
    $dest = $out ?? ($mode === "obj" ? $base . ".o" : ($mode === "asm" ? $base . ".s" : $base));
    $steps = [];
    if ($mode === "obj") { $steps[] = array_concat($args, ["-c", $tmp, "-o", $dest]); }
    else if ($mode === "asm") { $steps[] = array_concat($args, ["-S", $tmp, "-o", $dest]); }
    else {
        $rtobj = has_key($cacheOff, "x") ? null : runtime_object($gcc, $root, $cflags);
        if ($dry && $rtobj === null) { $rtobj = "<runtime.o>"; }
        if ($rtobj !== null) { $steps[] = array_concat($args, [$tmp, $rtobj, "-o", $dest, "-lm"]); }
        else { $steps[] = array_concat($args, [$tmp, $root . "/runtime/native/zs_rt.c", "-o", $dest, "-lm"]); }
    }
    foreach ($steps as $st) {
        if ($printCmd) {
            $q = [];
            foreach ($st as $a) { $q[] = quote($a); }
            eecho("+ " . $gcc . " " . join($q, " "));
        }
        if ($dry) { continue; }
        $r = Process.run($gcc, $st);
        if ($r["status"] !== 0) { File.delete($tmp); eecho($r["stderr"]); eecho("zzc: gcc zakończył się błędem " . $r["status"]); return 1; }
        if ($r["stderr"] !== "") { eecho($r["stderr"]); }
    }
    File.delete($tmp);
    if ($run && $mode === "exe" && !$dry) { return Process.exec(starts_with($dest, "/") ? $dest : "./" . $dest, $runArgs); }
    echo "zzc: " . $dest;
    return 0;
}

exit(main());
